#!/bin/bash

# YunoHost executes lifecycle hooks under bash -x; never log app secrets.
set +x

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers
source ../settings/scripts/_backup.sh
# Re-disable tracing after sourcing YunoHost helpers, which may re-enable it.
set +x

ynh_print_info "Creating a consistent backup of Continuwuity..."
if [[ "${BACKUP_CORE_ONLY:-0}" == 1 || "${do_not_backup_data:-0}" == 1 ]]; then
    ynh_print_warn "Continuwuity includes its database and matching media despite the requested data exclusion. This is necessary for a coordinated rollback; allow space for a complete backup."
fi
if continuwuity_s3_media_enabled; then
    ynh_print_info "The database is archived locally and media is copied to a matching immutable S3 generation. The service remains stopped until both snapshots are verified."
else
    ynh_print_info "All database and media files are included, including before upgrades. The service is stopped only while the snapshot is copied; allow free disk space for both the complete snapshot and the resulting archive."
fi

# Always include the database and its matching media snapshot. A RocksDB
# migration may make the old binary unable to read retained data, so a code-
# only safety backup is unsafe. BACKUP_CORE_ONLY and do_not_backup_data
# intentionally do not omit this copy.
continuwuity_snapshot_data

ynh_backup "$install_dir"
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"

ynh_print_info "The consistent data snapshot is ready for YunoHost to archive."
