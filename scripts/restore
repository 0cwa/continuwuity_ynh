#!/bin/bash

# YunoHost executes lifecycle hooks under bash -x; never log app secrets.
set +x

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers
source ../settings/scripts/_backup.sh
# Re-disable tracing after sourcing YunoHost helpers, which may re-enable it.
set +x
set -e

ynh_script_progression "Checking the Continuwuity backup..."

continuwuity_validate_data_path
# YunoHost's ynh_restore skips absent data; accepting that fallback for a
# RocksDB homeserver can destroy history or pair old binaries with new data.
archive_data="${YNH_APP_BACKUP_DIR:?}$data_dir"
[[ -d "$archive_data" && ! -L "$archive_data" ]] \
    || ynh_die "This archive has no complete Continuwuity database snapshot. Restore a full backup containing the database and its matching media snapshot."
# Reject an empty/partial RocksDB backup before replacing existing history.
continuwuity_validate_rocksdb_marker "$archive_data" \
    "The archive lacks a valid RocksDB CURRENT marker. Refusing to replace existing homeserver data."
# Detect storage mode from the archived config, never from the currently
# installed service. S3 archives require the matching remote generation file.
archive_media_backend="$(continuwuity_archive_media_backend)" \
    || ynh_die "Could not determine the archived media backend."
archive_s3_manifest="$(continuwuity_s3_manifest_path)"
restore_s3_media=0
if [[ -e "$archive_s3_manifest" || -L "$archive_s3_manifest" ]]; then
    [[ "$archive_media_backend" == s3 && -f "$archive_s3_manifest" && -s "$archive_s3_manifest" && ! -L "$archive_s3_manifest" ]] \
        || ynh_die "The archive's S3 media manifest is invalid or inconsistent with its config."
    restore_s3_media=1
elif [[ "$archive_media_backend" == s3 ]]; then
    ynh_die "This S3 archive has no matching media generation manifest. Refusing a database-only restore."
else
    continuwuity_require_local_media
    continuwuity_validate_media_tree "$archive_data/media" archived
fi
# Old data is kept until the restore is verified, so both copies must fit.
continuwuity_check_restore_space "$archive_data"

restore_previous_media_backend="${media_backend:-local}"
restore_previous_media_s3_bucket="${media_s3_bucket:-}"
restore_previous_media_s3_key_prefix="${media_s3_key_prefix:-}"
restore_media_settings_update=0
if [[ "$restore_previous_media_backend" != "$archive_media_backend" ]]; then
    restore_media_settings_update=1
fi
restore_media_target_bucket=""
restore_media_target_prefix=""
restore_s3_target_prepared=0
existing_config=0
existing_overrides=0

if [[ "$restore_s3_media" -eq 1 ]]; then
    # An S3-backed archive should contain only the DB locally; the remote
    # generation carries the media. Refuse a hybrid archive that could hide
    # stale or partial local media.
    continuwuity_validate_s3_media_data "$archive_data" archived
    continuwuity_require_local_data_mounts
    [[ -n "$media_s3_key_prefix" ]] \
        || ynh_die "An S3 restore requires the original nonempty live key prefix."
    restore_uuid="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')" \
        || ynh_die "Could not create a unique S3 restore prefix."
    [[ "$restore_uuid" =~ ^[0-9a-f]{32}$ ]] \
        || ynh_die "Could not create a valid unique S3 restore prefix."
    # The helper rejects overlap with the archived live prefix and any
    # nonempty destination. A top-level namespace keeps it separate from the
    # current live prefix and from future media listings.
    restore_media_target_bucket="$media_s3_bucket"
    restore_media_target_prefix=".ynh-restore-$restore_uuid"
    media_s3_restore_bucket="$restore_media_target_bucket"
    media_s3_restore_key_prefix="$restore_media_target_prefix"
    restore_media_settings_update=1
fi

if [[ -e "$install_dir" || -L "$install_dir" ]]; then
    [[ -d "$install_dir" && ! -L "$install_dir" ]] \
        || ynh_die "The existing Continuwuity install directory is not a real directory; refusing a reversible restore."
fi
if [[ -e "$install_dir/config.toml" || -L "$install_dir/config.toml" ]]; then
    [[ -f "$install_dir/config.toml" && ! -L "$install_dir/config.toml" ]] \
        || ynh_die "The existing Continuwuity config is not a regular file; refusing a reversible restore."
    existing_config=1
fi
if [[ -e "$install_dir/overrides.toml" || -L "$install_dir/overrides.toml" ]]; then
    [[ -f "$install_dir/overrides.toml" && ! -L "$install_dir/overrides.toml" ]] \
        || ynh_die "The existing Continuwuity overrides are not a regular file; refusing a reversible restore."
    existing_overrides=1
fi

# Check dependencies BEFORE moving any retained data or overwriting binaries.
# The actual Dex client registration still happens after files are restored.
if [[ "${auth_type:-password}" == dex ]]; then
    (
        set -e
        _continuwuity_dex_load
        discovery_metadata="$(mktemp)"
        trap 'rm -f -- "$discovery_metadata"' EXIT
        _continuwuity_dex_discovery_check "$discovery_metadata" \
            || ynh_die "Dex HTTPS discovery is unavailable. Restore Dex and its certificate before attempting Continuwuity restore."
    )
fi

if [[ "$restore_s3_media" -eq 1 ]]; then
    # The helper independently verifies the committed generation before its
    # first write, then verifies the completed target. Materialize into a fresh,
    # disjoint namespace while the current service/database/config are still
    # untouched. Never clean up a possibly partial target automatically.
    if ! continuwuity_run_s3_snapshot_helper restore "$archive_s3_manifest"; then
        ynh_print_warn "S3 restore target $restore_media_target_bucket/$restore_media_target_prefix may contain partial objects; it was left untouched."
        ynh_die "Could not restore and verify the S3 media generation into its empty target prefix. Existing data was not changed."
    fi
    restore_s3_target_prepared=1
fi

# On an existing installation, renaming a large directory on the same
# filesystem is cheap and non-destructive. YunoHost's normal ynh_restore
# deletes a target larger than 500 MB before proving the replacement works.
# Keep the old data until the new daemon passes readiness checks.
restore_rollback_dir=""
restore_had_existing_data=0
restore_had_existing_config=0
restore_had_existing_overrides=0
restore_config_state_recorded=0
restore_service_start_attempted=0
restore_succeeded=0
restore_settings_update_attempted=0

continuwuity_restore_cleanup() {
    local status=$? rollback_failed=0 rollback_safe=1
    trap - EXIT INT TERM
    set +e
    set +x
    if [[ "$restore_succeeded" -eq 0 && "$restore_service_start_attempted" -eq 1 ]] \
        && ! systemctl stop "$app.service"; then
        ynh_print_warn "Could not stop $app.service after the failed restore; leaving its current data and config untouched."
        rollback_failed=1
        rollback_safe=0
    fi
    if [[ "$restore_succeeded" -eq 0 \
        && ( "$restore_had_existing_data" -eq 1 \
            || "$restore_had_existing_config" -eq 1 \
            || "$restore_had_existing_overrides" -eq 1 \
            || "$restore_config_state_recorded" -eq 1 \
            || "$restore_settings_update_attempted" -eq 1 ) ]]; then
        ynh_print_warn "Restoration failed; recovering the original data and storage configuration."
        # A readiness/start failure can leave the new daemon running. Never
        # move or delete its data tree unless systemd confirms it stopped.
        if [[ "$rollback_safe" -eq 1 && "$restore_had_existing_data" -eq 1 \
            && ( -e "$data_dir" || -L "$data_dir" ) ]]; then
            if [[ -L "$data_dir" ]] || mountpoint --quiet "$data_dir"; then
                rollback_failed=1
            else
                mv -- "$data_dir" "$restore_rollback_dir/failed-data" || rollback_failed=1
            fi
        fi
        if [[ "$rollback_safe" -eq 1 && "$restore_had_existing_data" -eq 1 ]]; then
            mv -- "$restore_rollback_dir/original" "$data_dir" || rollback_failed=1
        fi
        if [[ "$rollback_safe" -eq 1 && "$restore_config_state_recorded" -eq 1 ]]; then
            if [[ -d "$install_dir" && ! -L "$install_dir" ]]; then
                for restore_config_name in config.toml overrides.toml; do
                    restore_config_path="$install_dir/$restore_config_name"
                    restore_config_was_present=0
                    restore_config_backup=""
                    case "$restore_config_name" in
                        config.toml)
                            restore_config_was_present="$restore_had_existing_config"
                            restore_config_backup="$restore_rollback_dir/original-config.toml"
                            ;;
                        overrides.toml)
                            restore_config_was_present="$restore_had_existing_overrides"
                            restore_config_backup="$restore_rollback_dir/original-overrides.toml"
                            ;;
                    esac

                    if [[ "$restore_config_was_present" -eq 1 ]]; then
                        if [[ -f "$restore_config_backup" && ! -L "$restore_config_backup" ]]; then
                            if [[ -e "$restore_config_path" || -L "$restore_config_path" ]]; then
                                if [[ -f "$restore_config_path" || -L "$restore_config_path" ]]; then
                                    rm -f -- "$restore_config_path" || rollback_failed=1
                                else
                                    rollback_failed=1
                                fi
                            fi
                            if [[ ! -e "$restore_config_path" && ! -L "$restore_config_path" ]]; then
                                cp -p -- "$restore_config_backup" "$restore_config_path" \
                                    || rollback_failed=1
                            fi
                        else
                            rollback_failed=1
                        fi
                    elif [[ -e "$restore_config_path" || -L "$restore_config_path" ]]; then
                        # The file was absent before restore. Remove only a
                        # regular file or the symlink itself; never recurse
                        # through an unexpected directory or special file.
                        if [[ -f "$restore_config_path" || -L "$restore_config_path" ]]; then
                            rm -f -- "$restore_config_path" || rollback_failed=1
                        else
                            rollback_failed=1
                        fi
                    fi
                done
            else
                rollback_failed=1
            fi
        fi
        if [[ "$rollback_safe" -eq 1 && "$restore_settings_update_attempted" -eq 1 ]]; then
            ynh_app_setting_set --key=media_backend --value="$restore_previous_media_backend" \
                || rollback_failed=1
            if [[ "$restore_s3_media" -eq 1 ]]; then
                ynh_app_setting_set --key=media_s3_bucket --value="$restore_previous_media_s3_bucket" \
                    || rollback_failed=1
                ynh_app_setting_set --key=media_s3_key_prefix --value="$restore_previous_media_s3_key_prefix" \
                    || rollback_failed=1
            fi
            media_backend="$restore_previous_media_backend"
            media_s3_bucket="$restore_previous_media_s3_bucket"
            media_s3_key_prefix="$restore_previous_media_s3_key_prefix"
        fi
        if [[ "$rollback_failed" -eq 0 ]]; then
            if [[ "$restore_had_existing_data" -eq 1 ]]; then
                ynh_print_warn "Original data recovered at $data_dir."
            else
                ynh_print_warn "Original storage configuration recovered."
            fi
            ynh_print_warn "YunoHost may have cleaned up the failed app; restore a verified complete backup to reinstall it."
        else
            ynh_print_warn "Automatic rollback failed. Retained original data/config are in or beside $restore_rollback_dir; do not delete them."
        fi
        status=1
    fi
    if [[ "$restore_succeeded" -eq 0 && "$restore_s3_target_prepared" -eq 1 ]]; then
        if [[ "$rollback_safe" -eq 1 ]]; then
            ynh_print_warn "The restored S3 media prefix $restore_media_target_bucket/$restore_media_target_prefix was left untouched and may be an orphan."
        else
            ynh_print_warn "The S3 media prefix $restore_media_target_bucket/$restore_media_target_prefix may still be in use by $app.service; do not delete it."
        fi
    fi
    if [[ -n "$restore_rollback_dir" ]]; then
        if [[ "$restore_succeeded" -eq 1 ]]; then
            # Delete only after the new data and services are verified healthy.
            rm -rf -- "$restore_rollback_dir" \
                || ynh_print_warn "Restore succeeded but old data could not be removed from $restore_rollback_dir."
        elif [[ "$rollback_failed" -eq 0 ]]; then
            # The original directory is safely back in place. Failed replacement
            # bytes are disposable; a failed deletion leaves an explicit warning.
            rm -rf -- "$restore_rollback_dir/failed-data" \
                || ynh_print_warn "Review failed restore residue at $restore_rollback_dir."
            rm -f -- "$restore_rollback_dir/original-config.toml" \
                || ynh_print_warn "Review retained restore config at $restore_rollback_dir."
            rm -f -- "$restore_rollback_dir/original-overrides.toml" \
                || ynh_print_warn "Review retained restore overrides at $restore_rollback_dir."
            rm -f -- "$restore_rollback_dir/original-config.toml.tmp" \
                "$restore_rollback_dir/original-overrides.toml.tmp" \
                || ynh_print_warn "Review incomplete rollback config copies at $restore_rollback_dir."
            rmdir -- "$restore_rollback_dir" 2>/dev/null \
                || ynh_print_warn "Review retained restore files at $restore_rollback_dir."
        fi
    fi
    exit "$status"
}
trap continuwuity_restore_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Stop the old daemon before moving its data directory: open RocksDB files
# would otherwise keep writing to the renamed rollback copy.
if [[ -e "/etc/systemd/system/$app.service" ]]; then
    systemctl stop "$app.service"
fi

existing_data=0
if [[ -d "$data_dir" && -n "$(find "$data_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    existing_data=1
fi
if [[ "$existing_data" -eq 1 || "$existing_config" -eq 1 || "$existing_overrides" -eq 1 ]]; then
    mountpoint --quiet "$data_dir" \
        && ynh_die "Cannot safely replace a mounted data directory. Restore to a local directory instead."
    restore_rollback_dir="$(mktemp -d -- "$(dirname "$data_dir")/.$app-restore-rollback.XXXXXXXX")"
    chmod 700 "$restore_rollback_dir"
    if [[ "$existing_config" -eq 1 ]]; then
        cp -p -- "$install_dir/config.toml" "$restore_rollback_dir/original-config.toml"
        restore_had_existing_config=1
    fi
    if [[ "$existing_overrides" -eq 1 ]]; then
        cp -p -- "$install_dir/overrides.toml" "$restore_rollback_dir/original-overrides.toml"
        restore_had_existing_overrides=1
    fi
fi
restore_config_state_recorded=1
if [[ "$existing_data" -eq 1 ]]; then
    mv -- "$data_dir" "$restore_rollback_dir/original"
    restore_had_existing_data=1
fi

ynh_script_progression "Restoring Continuwuity and its complete data snapshot..."
ynh_restore "$install_dir"
ynh_restore "$data_dir"

ynh_script_progression "Restoring YunoHost integrations..."
continuwuity_dex_setup
media_backend="$archive_media_backend"
if [[ "$restore_s3_media" -eq 0 ]]; then
    media_s3_restore_bucket=""
    media_s3_restore_key_prefix=""
fi
continuwuity_configure
continuwuity_permissions
continuwuity_register_service

ynh_script_progression "Starting Continuwuity..."
restore_service_start_attempted=1
ynh_systemctl --service="$app" --action=start
continuwuity_wait_ready

if [[ "$restore_media_settings_update" -eq 1 ]]; then
    restore_settings_update_attempted=1
    ynh_app_setting_set --key=media_backend --value="$archive_media_backend"
    media_backend="$archive_media_backend"
    if [[ "$restore_s3_media" -eq 1 ]]; then
        ynh_app_setting_set --key=media_s3_bucket --value="$restore_media_target_bucket"
        ynh_app_setting_set --key=media_s3_key_prefix --value="$restore_media_target_prefix"
        media_s3_bucket="$restore_media_target_bucket"
        media_s3_key_prefix="$restore_media_target_prefix"
    fi
fi

restore_succeeded=1
ynh_script_progression "Restoration completed for $app"
